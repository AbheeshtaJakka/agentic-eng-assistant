# Copy to .env for local development. Never commit .env.
OPEN_AI_KEY=''

# Leave blank to use the Agents SDK's default model, or set any model your account can use.
CODING_MODEL=
MAX_TURNS=25
TASK_TIMEOUT_S=300

# The API accepts repo NAMES under this folder (each subfolder is one repo).
REPOS_ROOT=./repos
AUDIT_LOG_PATH=./var/audit.jsonl

# Agents SDK tracing (sent to your OpenAI dashboard). Set true to turn off.
TRACING_DISABLED=false
LOG_LEVEL=INFO
